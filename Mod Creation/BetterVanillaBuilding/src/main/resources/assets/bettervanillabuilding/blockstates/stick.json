{
  "multipart": [
    {
      "when": { "facing": "down" },
      "apply": [
        { "model": "bettervanillabuilding:block/stick_1", "x": 180 },
        { "model": "bettervanillabuilding:block/stick_2", "x": 180 },
        { "model": "bettervanillabuilding:block/stick_3", "x": 180 }
      ]
    },
    {
      "when": { "facing": "east" },
      "apply": [
        { "model": "bettervanillabuilding:block/stick_1", "x": 90, "y": 90 },
        { "model": "bettervanillabuilding:block/stick_2", "x": 90, "y": 90 },
        { "model": "bettervanillabuilding:block/stick_3", "x": 90, "y": 90 }
      ]
    },
    {
      "when": { "facing": "north" },
      "apply": [
        { "model": "bettervanillabuilding:block/stick_1", "x": 90 },
        { "model": "bettervanillabuilding:block/stick_2", "x": 90 },
        { "model": "bettervanillabuilding:block/stick_3", "x": 90 }
      ]
    },
    {
      "when": { "facing": "south" },
      "apply": [
        { "model": "bettervanillabuilding:block/stick_1", "x": 90, "y": 180 },
        { "model": "bettervanillabuilding:block/stick_2", "x": 90, "y": 180 },
        { "model": "bettervanillabuilding:block/stick_3", "x": 90, "y": 180 }
      ]
    },
    {
      "when": { "facing": "up" },
      "apply": [
        { "model": "bettervanillabuilding:block/stick_1" },
        { "model": "bettervanillabuilding:block/stick_2" },
        { "model": "bettervanillabuilding:block/stick_3" }
      ]
    },
    {
      "when": { "facing": "west" },
      "apply": [
        { "model": "bettervanillabuilding:block/stick_1", "x": 90, "y": 270 },
        { "model": "bettervanillabuilding:block/stick_2", "x": 90, "y": 270 },
        { "model": "bettervanillabuilding:block/stick_3", "x": 90, "y": 270 }
      ]
    },
    {
      "when": { "north": "true" },
      "apply": [
        { "model": "bettervanillabuilding:block/stick_arm_1" },
        { "model": "bettervanillabuilding:block/stick_arm_2" },
        { "model": "bettervanillabuilding:block/stick_arm_3" }
