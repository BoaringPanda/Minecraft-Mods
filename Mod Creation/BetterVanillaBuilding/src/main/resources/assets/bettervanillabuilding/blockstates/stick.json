    },
    {
      "when": { "east": "true" },
      "apply": [
        { "model": "bettervanillabuilding:block/stick_arm_1", "y": 90 },
        { "model": "bettervanillabuilding:block/stick_arm_2", "y": 90 },
        { "model": "bettervanillabuilding:block/stick_arm_3", "y": 90 }
      ]
    },
    {
      "when": { "south": "true" },
      "apply": [
        { "model": "bettervanillabuilding:block/stick_arm_1", "y": 180 },
        { "model": "bettervanillabuilding:block/stick_arm_2", "y": 180 },
        { "model": "bettervanillabuilding:block/stick_arm_3", "y": 180 }
      ]
    },
    {
      "when": { "west": "true" },
      "apply": [
        { "model": "bettervanillabuilding:block/stick_arm_1", "y": 270 },
        { "model": "bettervanillabuilding:block/stick_arm_2", "y": 270 },
        { "model": "bettervanillabuilding:block/stick_arm_3", "y": 270 }
      ]
