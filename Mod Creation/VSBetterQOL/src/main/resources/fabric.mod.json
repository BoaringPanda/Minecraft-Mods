{
	"schemaVersion": 1,
	"id": "vsbetterqol",
	"version": "${version}",
	"name": "VS Better QOL",
	"description": "Vanilla-style quality of life tweaks.",
	"authors": [
		"BoaringPanda"
	],
	"contact": {
		"sources": "https://github.com/BoaringPanda/Minecraft-Mods"
	},
	"license": "MIT",
	"icon": "assets/vsbetterqol/icon.png",
