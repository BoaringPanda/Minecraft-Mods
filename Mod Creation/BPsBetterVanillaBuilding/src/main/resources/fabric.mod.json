{
	"schemaVersion": 1,
	"id": "bpsbettervanillabuilding",
	"version": "${version}",
	"name": "BP's Better Vanilla Building",
	"description": "Adds extra blocks to Minecraft.",
	"authors": [
		"BoaringPanda"
	],
	"contact": {
		"sources": "https://github.com/BoaringPanda/BPsBetterVanillaBuilding"
	},
	"license": "MIT",
	"icon": "assets/bpsbettervanillabuilding/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.boaringpanda.bpsbettervanillabuilding.BPsBetterVanillaBuilding"
		],
		"client": [
			"com.boaringpanda.bpsbettervanillabuilding.client.BPsBetterVanillaBuildingClient"
		]
	},
	"mixins": [
		"bpsbettervanillabuilding.mixins.json",
		{
			"config": "bpsbettervanillabuilding.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": ">=0.160.7"
	}
}
